# Copy to deploy/.env (never commit it) and fill in.

# Public name pointing at this server (DNS A/AAAA record). Caddy gets the
# certificate from Let's Encrypt; "localhost" uses Caddy's local CA.
SEAPORT_DOMAIN=seaport.example.com

# Secrets: generate each with `openssl rand -hex 32` (hex only: the
# Postgres password goes into a URL unescaped).
POSTGRES_PASSWORD=

# token mode (default): the admin token (web sign-in and CLI). Agents use
# crew tokens, one per agent, created in the web app or with
# `seaport crew tokens create <name> -agent <agent>`.
SEAPORT_ADMIN_TOKEN=

# Seals the WhatsApp keys at rest (`openssl rand -base64 32`). Optional in
# token mode: unset, Seaport generates one into the seaport_data volume. Keep
# a copy away from the backups: without it they can't be restored.
# SEAPORT_SECRET_KEY=

# Message images (sealed with that key). Default: /data/blobs in the
# seaport_data volume (back it up too). Or an S3 bucket:
# SEAPORT_BLOB_URL=s3://my-bucket?region=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# iam mode instead (docs/guides/operations/iam-mode.md): leave the tokens above empty, run
# scripts/iamkit-provision.sh with APP_URL=https://$SEAPORT_DOMAIN and paste
# its .iamkit.env here, and set SEAPORT_SECRET_KEY (required in iam mode).
# SEAPORT_AUTH=iam
# IAMKIT_URL=https://iam.example.com
# Only if browsers reach IAMKit elsewhere than IAMKIT_URL (e.g. IAMKIT_URL is
# http://iamkit:8080 on a shared Docker network), and if its issuer differs.
# IAMKIT_PUBLIC_URL=https://iam.example.com
# IAMKIT_ISSUER=https://iam.example.com
# IAMKIT_ENVIRONMENT_ID=
# IAMKIT_APPLICATION_ID=
# IAMKIT_RESOURCE_ID=
# IAMKIT_AUDIENCE=https://seaport.example.com
# IAMKIT_WEB_CLIENT_ID=

# Only if the public URL isn't https://$SEAPORT_DOMAIN (e.g. a non-443 port).
# SEAPORT_PUBLIC_URL=https://seaport.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Image tag (e.g. `git describe --always`).
# SEAPORT_VERSION=dev

# Outbound limits per WhatsApp number (0 disables one).
# SEAPORT_SEND_PER_MINUTE=20
# SEAPORT_SEND_PER_HOUR=300
# SEAPORT_SEND_PER_CHAT_MINUTE=8

# Quotas per organization (0 disables one).
# SEAPORT_SEND_ORG_PER_HOUR=1000
# SEAPORT_MAX_DOCKS=10
# SEAPORT_MAX_CREW_CONNECTIONS=20
# Requests per second (and burst) per caller on /api, /crew/ws, /mcp.
# SEAPORT_API_RATE=20
# SEAPORT_API_BURST=60

# Hosted agents: docker runs them on this server (start with
# `docker compose --profile hosting up -d --build`); off by default.
# SEAPORT_RUNTIME=docker
# SEAPORT_MAX_SLOTS=10
# SEAPORT_HOST_MAX_CPUS=4
# SEAPORT_HOST_MAX_MEMORY_MB=8192

# Backups into deploy/backups.
# BACKUP_EVERY_SECONDS=86400
# BACKUP_KEEP_DAYS=14
# Owner of the dump files (default root); `id -u` to copy them without sudo.
# BACKUP_UID=1000
