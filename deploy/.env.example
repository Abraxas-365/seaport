# Copy to deploy/.env (never commit it) and fill in.

# Public name pointing at this server (DNS A/AAAA record). Caddy gets the
# certificate from Let's Encrypt; "localhost" uses Caddy's local CA.
SEAPORT_DOMAIN=seaport.example.com

# Secrets: generate each with `openssl rand -hex 32` (hex only: the
# Postgres password goes into a URL unescaped).
POSTGRES_PASSWORD=
SEAPORT_ADMIN_TOKEN=
SEAPORT_CREW_TOKEN=

# Only if the public URL isn't https://$SEAPORT_DOMAIN (e.g. a non-443 port).
# SEAPORT_PUBLIC_URL=https://seaport.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Image tag (e.g. `git describe --always`).
# SEAPORT_VERSION=dev

# Outbound limits per WhatsApp number (0 disables one).
# SEAPORT_SEND_PER_MINUTE=20
# SEAPORT_SEND_PER_HOUR=300
# SEAPORT_SEND_PER_CHAT_MINUTE=8

# Backups into deploy/backups.
# BACKUP_EVERY_SECONDS=86400
# BACKUP_KEEP_DAYS=14
# Owner of the dump files (default root); `id -u` to copy them without sudo.
# BACKUP_UID=1000
