---
import { Code } from 'astro:components'
import { Image } from 'astro:assets'
import mark from '../assets/seaport-mark.svg'
import inbox from '../../../docs/assets/screenshots/inbox.png'
import customs from '../../../docs/assets/screenshots/customs.png'
import agentProfile from '../../../docs/assets/screenshots/agent-profile.png'
import { repository, base } from '../../scripts/docs.mjs'
import '../styles/landing.css'

// Internal links go through the deploy base (/seaport/ on GitHub Pages).
const u = (path: string) => base + path

const release = `VERSION=0.7.0   # see Releases for the latest
curl -sSfLO "${repository}/releases/download/v$VERSION/seaport_\${VERSION}_darwin_arm64.tar.gz"
tar -xzf seaport_\${VERSION}_darwin_arm64.tar.gz seaport && sudo mv seaport /usr/local/bin/`
const installs = [
  { id: 'release', label: 'Release binary', note: 'Linux, macOS and Windows on amd64 and arm64, web app embedded. Each release has a checksums.txt.', code: release },
  { id: 'go', label: 'go install', note: 'Needs Go 1.26. This build has no web app (it can’t run the web build): fine for the connector and the CLI.', code: 'go install github.com/Abraxas-365/seaport/cmd/seaport@latest' },
  { id: 'docker', label: 'Docker image', note: 'Distroless, non-root. /data keeps the secret key and the default blob store: mount a volume.', code: `docker build -t seaport .\ndocker run --rm -e DATABASE_URL=… -e SEAPORT_ADMIN_TOKEN=… \\\n  -e SEAPORT_ADDR=0.0.0.0:8740 -v seaport_data:/data -p 8740:8740 seaport serve` },
]
const run = `# Postgres on 127.0.0.1:5449 (compose file in the repository)
docker compose up -d
export DATABASE_URL="postgres://seaport:seaport@127.0.0.1:5449/seaport?sslmode=disable"

# no login, loopback only: for your own computer
SEAPORT_AUTH=none seaport serve      # → http://127.0.0.1:8740`
const connect = `seaport dock add slack    # or github, jira, whatsapp, api
seaport agents add pm -description "Answers about tickets"
seaport agents assign pm <dock-id> -default

# from the directory the agent should work in
seaport connect -agent pm -- rness --acp`
const env = `# env.yaml · seaport env apply -f env.yaml
name: backend
harness: rness                    # rness | claude-code
repos:
  - url: https://github.com/acme/api.git
    credential: \${GITHUB_TOKEN}   # a secret of the hosted agent
home: ./rness-home                # your own harness config
models:
  anthropic: \${ANTHROPIC_API_KEY} # through the port's gateway
network:
  egress: [registry.npmjs.org]
idle_stop: 30m`
const features = [
  { number: '01', title: 'Docks', text: 'A Slack app, a GitHub App on your repositories, a Jira service account, a WhatsApp number or an api dock. People call an agent with @name where they already work.', tags: 'Slack · GitHub · Jira · WhatsApp · HTTP', href: u('docs/explanation/concepts/') },
  { number: '02', title: 'Customs', text: 'Per-dock defaults and allow/deny rules decide who may wake an agent. What doesn’t pass is held: stored, visible, never delivered.', tags: 'Rules · Overrides · Groups', href: u('docs/guides/customs/') },
  { number: '03', title: 'Crew and routing', text: 'A library of agents (@pm, @reviewer…) on the docks you assign. @name picks one; otherwise the chat stays with its agent or goes to the default.', tags: 'Agents · Teams · @mentions', href: u('docs/guides/agents-and-routing/') },
  { number: '04', title: 'Profiles', text: 'Instructions, skills, MCP servers and sealed secrets live in the port. Save a change and every connection picks it up.', tags: 'Versions · Skills · MCP', href: u('docs/guides/profiles/') },
  { number: '05', title: 'Any ACP agent', text: 'The connector dials out and runs rness, Claude Code or any ACP agent: one session per conversation, resumed across restarts.', tags: 'seaport connect · ACP', href: u('docs/guides/connector/') },
  { number: '06', title: 'Nothing lost', text: 'One delivery per conversation at a time, leased while the agent works and released if it drops. Mid-turn messages are steered in.', tags: 'Leases · Steer · Replays', href: u('docs/explanation/message-lifecycle/') },
]
const flow = [
  { step: 'Arrive', text: 'A ship docks: a Slack mention, a pull request comment, a Jira comment, a WhatsApp message or a POST.' },
  { step: 'Customs', text: 'The dock’s rules allow it, deny it or hold it for you.' },
  { step: 'Route', text: '@name, the chat’s agent, the only one, or the default.' },
  { step: 'Work', text: 'The agent’s session gets the message, with its kit.' },
  { step: 'Reply', text: 'It answers in the same thread with the port’s MCP tools: reply, history.' },
]
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seaport — A port for your AI agents</title>
    <meta name="description" content="Your company's AI agents, defined once and called with @name from Slack, GitHub, Jira, WhatsApp or your own systems. Customs decides who may wake them; they run on a laptop or hosted by the port." />
    <meta property="og:title" content="Seaport — A port for your AI agents" />
    <meta property="og:description" content="Messages arrive. Customs decides. Your agents do the work." />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Share the user's explicit choice with the documentation, before first paint.
      try {
        const saved = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = saved === 'light' || (!saved && matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <nav class="wrap navigation" aria-label="Main navigation">
        <a class="brand" href={u('')} aria-label="Seaport home"><img src={mark.src} width="28" height="28" alt="" />Seaport</a>
        <div class="nav-links"><a href="#what">What it is</a><a href="#start">Get started</a><a href="#hosting">Hosting</a><a href={u('docs/')}>Documentation</a></div>
        <div class="nav-actions">
          <button id="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg></button>
          <a class="github-link" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="signal" aria-hidden="true"></span> A port for your AI agents</p>
          <h1 id="hero-title">Messages arrive.<br /><span>Your agents work them.</span></h1>
          <p class="hero-description">Call your company’s agents with @name from Slack, GitHub, Jira, WhatsApp or your own systems.<br class="desktop-break" /> Decide who gets through. Run each agent on a laptop, or let the port host it.</p>
          <div class="install-box" aria-label="Install command">
            <div class="install-bar"><span class="mono">connector + CLI · Go 1.26</span><button class="copy" type="button" data-copy="go install github.com/Abraxas-365/seaport/cmd/seaport@latest">Copy</button></div>
            <pre><code><span class="prompt">$</span> go install github.com/Abraxas-365/seaport/cmd/seaport@latest</code></pre>
          </div>
          <div class="actions"><a class="button primary" href={u('docs/tutorials/first-port/')}>Your first port <span aria-hidden="true">→</span></a><a class="button secondary" href={u('docs/')}>Read the docs <span aria-hidden="true">↗</span></a></div>
          <p class="hero-note">Go server <span aria-hidden="true">/</span> Postgres <span aria-hidden="true">/</span> Any ACP agent</p>
        </div>
      </section>

      <section class="showcase wrap" aria-label="The Seaport web app">
        <figure class="browser">
          <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="address">127.0.0.1:8740/inbox</span></div>
          <Image src={inbox} widths={[960, 1440, 2160]} sizes="(max-width: 1160px) 100vw, 1160px" alt="The Seaport inbox: conversations on the left, a chat where the agent pm answers a customer about a ticket on the right." loading="eager" />
          <figcaption>The web app’s inbox, live over server-sent events. The interface is in Spanish; the documentation names every page in English. Sample data.</figcaption>
        </figure>
      </section>

      <div class="provider-strip"><div class="wrap provider-inner"><p>Channels in, agents out.</p><ul aria-label="Supported channels and agents"><li>Slack</li><li>GitHub</li><li>Jira</li><li>WhatsApp</li><li>HTTP api docks</li><li>rness</li><li>Claude Code</li><li>Any ACP agent</li></ul></div></div>

      <section id="what" class="section wrap" aria-labelledby="what-title">
        <div class="section-heading"><div><p class="eyebrow">What is Seaport</p><h2 id="what-title">Channels bring the ships.<br /><span>Your crew does the work.</span></h2></div><p>Seaport sits between the places people already work, chat apps, code review, issue trackers, and the AI agents that answer. It stores every message, decides which ones may wake an agent, picks the right agent, and hands it the tools to reply.</p></div>
        <div class="feature-grid">{features.map(feature => <article class="feature"><span class="feature-number">{feature.number} /</span><h3><a href={feature.href}>{feature.title}<span aria-hidden="true">↗</span></a></h3><p>{feature.text}</p><span class="feature-tags">{feature.tags}</span></article>)}</div>
        <ol class="flow" aria-label="The life of a message">{flow.map((item, i) => <li><span class="flow-number">{String(i + 1).padStart(2, '0')}</span><strong>{item.step}</strong><p>{item.text}</p></li>)}</ol>
        <p class="split-note"><strong>Channels bring the ships.</strong> Customs decides. <span>Your agents do the work.</span></p>
      </section>

      <section id="start" class="install-section" aria-labelledby="start-title"><div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">Get started</p><h2 id="start-title">From install<br />to first reply.</h2></div><p>One binary is the port (<code>seaport serve</code>), its admin CLI and the agent connector (<code>seaport connect</code>). Everything lives in Postgres. No model key is needed to try it.</p></div>
        <ol class="steps-grid">
          <li class="step">
            <span class="step-number">01 / Install</span>
            <h3>Take the binary.</h3>
            <div class="tabs" role="tablist" aria-label="Installation method">{installs.map((item, i) => <button type="button" role="tab" id={`tab-${item.id}`} aria-controls={`panel-${item.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{item.label}</button>)}</div>
            {installs.map((item, i) => <div class="tab-panel code-panel" role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} hidden={i !== 0}><button class="copy floating" type="button" data-copy={item.code}>Copy</button><Code code={item.code} lang="sh" theme="css-variables" /><p class="code-note">{item.note}</p></div>)}
            <p class="step-foot">Install it on the server that runs the port and on every machine that runs an agent. <a class="text-link" href={u('docs/guides/installation/')}>Install guide →</a></p>
          </li>
          <li class="step">
            <span class="step-number">02 / Run</span>
            <h3>Start the port.</h3>
            <div class="code-panel"><Code code={run} lang="sh" theme="css-variables" /></div>
            <p class="step-foot">Going beyond your computer? Use <code>token</code> mode, or the deploy stack with HTTPS. <a class="text-link" href={u('docs/tutorials/first-port/')}>Your first port →</a></p>
          </li>
          <li class="step">
            <span class="step-number">03 / Connect</span>
            <h3>Put an agent to work.</h3>
            <div class="code-panel"><Code code={connect} lang="sh" theme="css-variables" /></div>
            <p class="step-foot">The connector dials out: the agent’s machine needs no public address. <a class="text-link" href={u('docs/tutorials/first-agent/')}>Your first agent →</a></p>
          </li>
        </ol>
        <p class="step-foot">Slack, GitHub and Jira call the port by webhook, so it needs a public <code>https</code> URL. Guides: <a class="text-link" href={u('docs/guides/slack/')}>Slack</a> · <a class="text-link" href={u('docs/guides/github/')}>GitHub</a> · <a class="text-link" href={u('docs/guides/jira/')}>Jira</a> · <a class="text-link" href={u('docs/guides/whatsapp/')}>WhatsApp</a> · <a class="text-link" href={u('docs/guides/api-docks/')}>api docks</a>.</p>
        <p class="warning"><strong>Heads-up:</strong> the WhatsApp channel links a number through an unofficial client (whatsmeow). Numbers that send in bursts get banned, which is why outbound limits are on by default. Slack, GitHub and Jira use their official APIs. <a href={u('docs/guides/whatsapp/')}>WhatsApp guide</a>.</p>
      </div></section>

      <section class="section wrap make-section" aria-labelledby="customs-title">
        <div>
          <p class="eyebrow">Customs</p>
          <h2 id="customs-title">Anyone can write.<br /><span>You decide who gets through.</span></h2>
          <p class="section-description">Each dock asks, allows or denies new conversations, matches them against rules (a number like <code>+34*</code>, a Slack channel, a repository, a Jira project, a GitHub handle like <code>github:outsider</code>), and wakes agents in groups only when they are mentioned. Held messages are never dropped: allow a chat and what it sent in the last day goes to the agent.</p>
          <pre class="tree" aria-label="Customs commands"><span class="cm"># add -dock &lt;id&gt; when the port has several docks</span>
<span class="dir">$</span> seaport customs default ask           <span class="cm">new conversations wait for you</span>
<span class="dir">$</span> seaport customs allow "acme/*"        <span class="cm">these repositories may wake it</span>
<span class="dir">$</span> seaport customs deny github:outsider   <span class="cm">never people outside the repo</span>
<span class="dir">$</span> seaport customs groups mentions       <span class="cm">groups: only @mentions</span></pre>
          <div class="link-row"><a class="text-link" href={u('docs/guides/customs/')}>The customs guide →</a><a class="text-link" href={u('docs/explanation/security-model/')}>Security model →</a></div>
        </div>
        <figure class="browser small"><div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="address">Aduana · Customs</span></div><Image src={customs} widths={[720, 1080, 1440]} sizes="(max-width: 1000px) 100vw, 600px" alt="The customs page: a pending chat waiting for a decision, the dock's default (ask, allow, deny), group mode and rules." /></figure>
      </section>

      <section class="section wrap delegate-section" aria-labelledby="profile-title">
        <figure class="browser small"><div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="address">Agentes · @pm</span></div><Image src={agentProfile} widths={[720, 1080, 1440]} sizes="(max-width: 1000px) 100vw, 600px" alt="The profile of the agent pm: instructions, model, reasoning effort, harness permissions and skills." /></figure>
        <div>
          <p class="eyebrow">Profiles</p>
          <h2 id="profile-title">Shape what agents know.<br /><span>From one place.</span></h2>
          <p class="section-description">An agent’s instructions, skills, MCP servers, secrets, model and effort live in the port, versioned. Whatever runs the agent, your laptop or a hosted slot, applies them. Save a change and each connection finishes its turn, restarts the harness with it and resumes its sessions.</p>
          <p class="note">Secrets are sealed at rest, never shown again, and handed only to the agent’s own connections.</p>
          <div class="link-row"><a class="text-link" href={u('docs/guides/profiles/')}>Profiles guide →</a><a class="text-link" href={u('docs/reference/agent-profile/')}>Profile reference →</a></div>
        </div>
      </section>

      <section id="hosting" class="section wrap make-section" aria-labelledby="hosting-title">
        <div>
          <p class="eyebrow">Let the port host them</p>
          <h2 id="hosting-title">No laptop left open.<br /><span>Hardened slots instead.</span></h2>
          <p class="section-description">The port can run rness or Claude Code itself, in a container per slot, started when messages arrive and stopped when idle. Each conversation works in its own git worktree.</p>
          <ul class="checks">
            <li><strong>Model gateway.</strong> Slots call Anthropic through the port: the key never enters the container, and usage is metered.</li>
            <li><strong>Egress allowlist.</strong> Slots reach only the hosts you list and their repos, never private addresses.</li>
            <li><strong>Your harness config.</strong> Upload your <code>~/.rness</code> or <code>~/.claude</code> as a versioned home.</li>
            <li><strong>Credentials on demand.</strong> Git asks the port each time; no token on disk.</li>
          </ul>
          <div class="link-row"><a class="text-link" href={u('docs/guides/hosting/hosted-agents/')}>Hosted agents →</a><a class="text-link" href={u('docs/guides/hosting/network/')}>Gateway and egress →</a></div>
        </div>
        <div class="code-panel big"><div class="panel-bar"><span class="panel-label">env.yaml</span><span class="panel-caption">YAML</span></div><Code code={env} lang="yaml" theme="css-variables" /></div>
      </section>

      <section class="section wrap" aria-labelledby="modes-title">
        <div class="section-heading"><div><p class="eyebrow">From one laptop to many organizations</p><h2 id="modes-title">One binary.<br />Three modes.</h2></div><p>Only the start-up setting <code>SEAPORT_AUTH</code> differs. Inside, Seaport is always multi-tenant, so moving between modes needs no data migration.</p></div>
        <div class="mode-grid">
          <a class="mode-card" href={u('docs/tutorials/first-port/')}><span class="mono card-kicker">01 / NONE</span><h3>Your computer <span aria-hidden="true">↗</span></h3><p>No login, no tokens. Loopback only: refuses other addresses and anything relayed by a proxy or tunnel.</p></a>
          <a class="mode-card" href={u('docs/guides/operations/deploy/')}><span class="mono card-kicker">02 / TOKEN</span><h3>One owner, a server <span aria-hidden="true">↗</span></h3><p>A static admin token; agents sign in with crew tokens. The deploy stack adds HTTPS and backups.</p></a>
          <a class="mode-card" href={u('docs/guides/operations/iam-mode/')}><span class="mono card-kicker">03 / IAM</span><h3>Many organizations <span aria-hidden="true">↗</span></h3><p>Accounts, organizations, roles and permissions through IAMKit. Every row belongs to one organization.</p></a>
          <a class="mode-card" href={u('docs/guides/operations/several-processes/')}><span class="mono card-kicker">04 / SCALE</span><h3>Several processes <span aria-hidden="true">↗</span></h3><p>Replicas coordinate through Postgres: events, crew presence and WhatsApp dock ownership. Webhook channels run on any replica.</p></a>
        </div>
      </section>

      <section class="section wrap status-section" aria-labelledby="status-title">
        <div><p class="eyebrow">Know what you’re adopting</p><h2 id="status-title">Early-stage software.<br /><span>Honest about it.</span></h2></div>
        <div class="status-grid">
          <article><span class="mono card-kicker">SOURCE</span><h3>Read the code.</h3><p>A Go server with a hexagonal layout whose rules are enforced by architecture tests, and a React web app embedded in the binary.</p><a class="text-link" href={u('docs/architecture/')}>Architecture →</a></article>
          <article><span class="mono card-kicker">LIMITS</span><h3>Read the caveats.</h3><p>Five channels so far, images the only inbound media, and the web app speaks Spanish. Formats may still change.</p><a class="text-link" href={u('docs/project/known-limitations/')}>Known limitations →</a></article>
          <article><span class="mono card-kicker">TRUST</span><h3>Know the boundaries.</h3><p>Customs is the gate; agents can’t change it. Secrets are sealed; hosted slots are hardened containers behind an egress allowlist.</p><a class="text-link" href={u('docs/explanation/security-model/')}>Security model →</a></article>
        </div>
      </section>

      <section class="section wrap faq-section" aria-labelledby="faq-title"><div><p class="eyebrow">A few useful answers</p><h2 id="faq-title">Before you start.</h2></div><div class="faq-list">
        <details><summary>Which channels can people use to reach an agent?</summary><p>Slack (mentions, threads and DMs), GitHub (pull requests and issues, or a workflow step), Jira (issues and comments), WhatsApp (a linked number) and <code>api</code> docks for your own systems. One agent can work on several at once. <a href={u('docs/explanation/concepts/')}>Concepts</a>.</p></details>
        <details><summary>What do I need to try it?</summary><p>Only your computer. An <code>api</code> dock has nothing behind it: you post messages over HTTP and read the replies from the history or the live event stream. <a href={u('docs/tutorials/first-port/')}>Your first port</a> uses one.</p></details>
        <details><summary>Which agents can I connect?</summary><p>Any agent that speaks the Agent Client Protocol (ACP): rness, Claude Code through claude-agent-acp, and others. The agent answers with Seaport’s MCP tools; for agents without HTTP MCP, <code>-auto-reply</code> sends their final text. <a href={u('docs/guides/connector/')}>The connector</a>.</p></details>
        <details><summary>Does the agent’s machine need a public address?</summary><p>No. <code>seaport connect</code> dials out to the port over a WebSocket, like a tunnel, and reconnects on its own.</p></details>
        <details><summary>Who pays for the model?</summary><p>You do, with your own keys or subscriptions. A connected agent uses whatever its harness is configured with; a hosted one calls Anthropic through the port’s gateway with a key you store as the agent’s secret. <a href={u('docs/guides/hosting/network/')}>Model gateway</a>.</p></details>
        <details><summary>Can strangers make my agent do things?</summary><p>Only if customs lets their conversation in. New conversations wait for you by default, a rule can deny people outside a GitHub repository, groups wake the agent only on mentions, and the agent can’t change customs. <a href={u('docs/guides/customs/')}>Customs</a>.</p></details>
      </div></section>

      <section class="closing wrap" aria-labelledby="closing-title"><p class="eyebrow">Messages arrive. Customs decides. Your agents work them.</p><h2 id="closing-title">Open your port.<br /><span>Put your crew to work.</span></h2><div class="actions"><a class="button primary" href={u('docs/tutorials/first-port/')}>Your first port <span aria-hidden="true">→</span></a><a class="button secondary" href={u('docs/')}>Read the documentation <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="footer"><div class="wrap footer-inner"><div><a class="brand" href={u('')}><img src={mark.src} width="22" height="22" alt="" />Seaport</a><p>A port for your AI agents.</p></div><nav aria-label="Footer navigation"><a href={u('docs/')}>Documentation</a><a href={u('docs/guides/installation/')}>Install</a><a href={u('docs/reference/http-api/')}>API</a><a href={u('docs/project/known-limitations/')}>Known limitations</a><a href={u('docs/contributing/')}>Contributing</a><a href={repository}>GitHub</a></nav><span class="footer-note">Channels bring the ships. Your crew does the work.</span></div></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle')!
      function labelTheme() {
        toggle.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`)
      }
      labelTheme()
      toggle.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = theme
        try { localStorage.setItem('starlight-theme', theme) } catch {}
        labelTheme()
      })

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '')
            button.textContent = 'Copied'
          } catch {
            button.textContent = 'Select & copy'
          }
          setTimeout(() => { button.textContent = 'Copy' }, 1600)
        })
      }

      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
      function select(tab: HTMLButtonElement) {
        for (const other of tabs) {
          const selected = other === tab
          other.setAttribute('aria-selected', String(selected))
          other.tabIndex = selected ? 0 : -1
          document.getElementById(other.getAttribute('aria-controls')!)!.hidden = !selected
        }
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab))
        tab.addEventListener('keydown', event => {
          const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0
          if (!step) return
          const next = tabs[(i + step + tabs.length) % tabs.length]
          select(next)
          next.focus()
        })
      })
    </script>
  </body>
</html>
